<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="gifsmith"
        Arguments=""
        InstallLocation="C:\Program Files\Ken Scott\Gifsmith">
    </Installer>
    <PackageInformation
        PackageName="Gifsmith"
        PackageDisplayName="Gifsmith"
        PublisherName="CN=Ken Scott"
        PublisherDisplayName="Ken Scott"
        Version="0.1.0.0"
        PackageDescription="A gifsmith application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.kenscott.gifsmith"
                Description="A gifsmith application"
                DisplayName="Gifsmith"
                ExecutableName="gifsmith"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Gifsmith</DisplayName>
            <PublisherDisplayName>Ken Scott</PublisherDisplayName>
            <Description>A gifsmith application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="gifsmith.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
